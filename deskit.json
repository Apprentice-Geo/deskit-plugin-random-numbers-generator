{
  "$schema": "./schema/deskit-manifest.schema.json",
  "id": "com.deskit.random-numbers-generator",
  "name": "random-numbers-generator",
  "displayName": {
    "en": "Random Numbers Generator",
    "zh-CN": "随机数生成器"
  },
  "description": {
    "en": "Generate random integers by range and count.",
    "zh-CN": "按范围和数量生成随机整数。"
  },
  "version": "0.1.1",
  "author": "DesKit",
  "icon": "lucide:dices",
  "engines": {
    "deskit": "^0.2.0"
  },
  "main": "dist/index.js",
  "contributes": {
    "commands": [
      {
        "id": "random-numbers-generator.generate",
        "title": {
          "en": "Random Numbers",
          "zh-CN": "随机数"
        },
        "subtitle": {
          "en": "Generate integers: min max [count] [--unique]",
          "zh-CN": "生成整数：min max [count] [--unique]"
        },
        "keywords": [
          "random",
          "number",
          "numbers",
          "generator",
          "integer",
          "rng",
          "unique",
          "随机",
          "随机数",
          "整数",
          "去重"
        ],
        "icon": "lucide:dices",
        "mode": "view"
      }
    ]
  },
  "permissions": ["clipboard:write"]
}